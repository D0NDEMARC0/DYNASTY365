{
  "name": "Dynasty 365",
  "short_name": "Dynasty 365",
  "description": "Dynasty fantasy football rankings and advanced analytics",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#080c14",
